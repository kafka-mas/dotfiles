{
    "label" : "lock",
    "action" : "loginctl lock-session",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "sleep1; systemctl suspend-then-hibernate",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "logout",
    "action" : "loginctl terminate-user $USER",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "reboot",
    "action" : "sleep 1; systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "sleep 1; systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "windows",
    "action" : "sleep 1; systemctl reboot --boot-loader-entry=auto-windows",
    "text" : "Reboot to Windows",
}
